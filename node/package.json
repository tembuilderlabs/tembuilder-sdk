{
  "name": "@tembuilderlabs/sdk",
  "version": "0.4.0",
  "description": "Official Node.js and TypeScript SDK for the Tembuilder PDF rendering API.",
  "license": "MIT",
  "homepage": "https://tembuilder.com/pdf-generation-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tembuilderlabs/tembuilder-sdk.git",
    "directory": "node"
  },
  "bugs": "https://github.com/tembuilderlabs/tembuilder-sdk/issues",
  "keywords": [
    "tembuilder",
    "pdf",
    "pdf-generation",
    "templates",
    "api",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "openapi-typescript ../openapi/tembuilder.yaml --output src/generated/schema.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "check:pack": "npm pack --dry-run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "openapi-typescript": "7.13.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
